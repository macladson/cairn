{
  "hooks": {
    "SessionStart": [
      {"matcher": "startup|resume",
       "hooks": [{"type": "command", "command": "cairn hook session-start", "timeout": 30, "statusMessage": "Loading Cairn context"}]}
    ],
    "PostToolUse": [
      {"matcher": ".*", "hooks": [{"type": "command", "command": "cairn hook tool", "timeout": 15}]}
    ],
    "SessionEnd": [
      {"hooks": [{"type": "command", "command": "cairn hook session-end --harness codex", "timeout": 30}]}
    ]
  }
}
